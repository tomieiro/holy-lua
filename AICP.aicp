@aicp version=1 format=line-oriented
@stack root=README.md source_of_truth=repository
@agent purpose="navigate and modify the Lua-to-HolyC TempleOS port" rule="verify paths and commands against repository evidence"
@handoff status="paused" owner="user/Claude" scope="continue the HolyC nucleus port after the block scoping milestone" rule="read this AICP before editing; do not assume full Lua VM support"
@avoid path=build/ reason="generated artifacts; ignored by Git"
@mod id=lua_reference path=src/lua/ role="Lua 5.4.9 reference implementation"
@mod id=templeos_platform path=src/platform/templeos/ role="HolyC platform boundary"
@mod id=templeos_memory path=src/platform/templeos/lua_memory.hc role="Lua allocator accounting and lifecycle"
@mod id=templeos_exceptions path=src/platform/templeos/lua_exceptions.hc role="HolyC protected execution and error propagation"
@mod id=templeos_runtime path=src/platform/templeos/lua_runtime.hc role="runtime lifetime owner joining memory and exceptions"
@mod id=templeos_state path=src/platform/templeos/lua_state.hc role="initial HolyC Lua value and stack representation"
@mod id=templeos_table path=src/platform/templeos/lua_table.hc role="integer-key hash table for the HolyC Lua state"
@mod id=templeos_gc path=src/platform/templeos/lua_gc.hc role="initial root-aware collection facade"
@mod id=templeos_call path=src/platform/templeos/lua_call.hc role="native closures and protected call frames"
@mod id=templeos_mini path=src/platform/templeos/lua_mini.hc role="executable Lua nucleus: nil/boolean/number/string values, statement blocks, loops, general expressions, and recursive user-defined functions"
@mod id=templeos_string path=src/platform/templeos/lua_string.hc role="length-aware hashed Lua strings"
@mod id=templeos_entry path=src/templeos/ role="TempleOS HolyC entrypoints"
@mod id=lua_tests path=tests/lua/testes/ role="Lua reference tests"
@mod id=holyc_tests path=tests/holyc_table.hc role="HolyC table smoke test"
@mod id=holyc_call_tests path=tests/holyc_call.hc role="HolyC closure/frame smoke test"
@mod id=holyc_mini_tests path=tests/holyc_mini.hc role="end-to-end numeric Lua nucleus test"
@mod id=docs path=docs/ role="port status and design notes"
@inv id=host_build command="make host" claim="host interpreter builds from src/lua/" evidence=Makefile
@inv id=holy_c_layer command="hcc -c -o build/hcc/lua-platform.o src/platform/templeos/templeos_api.hc" claim="platform layer compiles with hcc when installed" evidence=src/platform/templeos/templeos_api.hc
@inv id=holy_c_entry command="hcc -c -o build/hcc/lua-entry.o src/templeos/lua.hc" claim="TempleOS entry compiles with hcc when installed" evidence=src/templeos/lua.hc
@inv id=holy_c_table_test command="hcc -c -o build/hcc/holyc-table-test.o tests/holyc_table.hc" claim="string-key table smoke test compiles with hcc" evidence=tests/holyc_table.hc
@inv id=holy_c_runtime_test command="hcc -jit tests/holyc_table.hc" claim="HolyC runtime/table smoke test executes successfully under hcc" evidence=tests/holyc_table.hc
@inv id=holy_c_call_test command="hcc -jit tests/holyc_call.hc" claim="native closure call executes through a protected frame" evidence=tests/holyc_call.hc
@inv id=holy_c_mini_test command="hcc -jit tests/holyc_mini.hc" claim="numeric Lua nucleus evaluates arithmetic source end to end" evidence=tests/holyc_mini.hc
@inv id=holy_c_mini_registry_test command="hcc -jit tests/holyc_mini.hc" claim="numeric Lua nucleus invokes a registered HolyC native function" evidence=tests/holyc_mini.hc
@inv id=holy_c_mini_loops_test command="hcc -jit tests/holyc_mini.hc" claim="Lua nucleus runs while, numeric for, repeat/until, nested if/elseif/else, break, goto/label, and/or short-circuit, general values (nil/boolean/number/string), string concatenation, user-defined functions with multiple parameters and real recursion (factorial, fibonacci), and early return" evidence=tests/holyc_mini.hc
@inv id=holy_c_string_pool_test command="hcc -c -o build/hcc/holyc-table-test.o tests/holyc_table.hc" claim="table smoke test exercises interned string ownership" evidence=tests/holyc_table.hc
@flow id=host_validation steps="make host -> make test"
@flow id=templeos_preparation steps="make templeos-prepare -> compile .hc inside TempleOS"
@resolver id=platform_boundary path=src/platform/templeos/templeos_api.hc resolves="memory,console,files,time"
@contract id=lua_allocator path=src/lua/lmem.c claim="Lua allocator must preserve realloc semantics: size zero frees, failed growth returns NULL, and GC debt changes only after success" evidence=src/lua/lmem.c
@contract id=holyc_allocator path=src/platform/templeos/lua_memory.hc claim="HolyC allocator tracks live bytes and allocation count while preserving Lua realloc semantics" evidence=src/platform/templeos/lua_memory.hc
@contract id=holyc_exceptions path=src/platform/templeos/lua_exceptions.hc claim="protected callback returns the I64 status thrown by HolyC" evidence=src/platform/templeos/lua_exceptions.hc
@contract id=holyc_runtime path=src/platform/templeos/lua_runtime.hc claim="runtime owns platform initialization, allocator state, protected calls, and shutdown" evidence=src/platform/templeos/lua_runtime.hc
@contract id=holyc_state path=src/platform/templeos/lua_state.hc claim="LuaState owns a growable LuaValue stack and releases its storage through LuaRuntime" evidence=src/platform/templeos/lua_state.hc
@contract id=holyc_table path=src/platform/templeos/lua_table.hc claim="integer-key table supports collision-safe set/get and releases entries through LuaRuntime" evidence=src/platform/templeos/lua_table.hc
@contract id=holyc_string path=src/platform/templeos/lua_string.hc claim="LuaString stores explicit length, NUL-terminated data, and content hash under runtime ownership" evidence=src/platform/templeos/lua_string.hc
@contract id=holyc_string_ownership path=src/platform/templeos/lua_string.hc claim="LuaString lifetime is reference-counted and LuaValue releases string references" evidence=src/platform/templeos/lua_state.hc
@contract id=holyc_string_pool path=src/platform/templeos/lua_string.hc claim="string pool interns equal byte sequences and holds one reference until pool close" evidence=src/platform/templeos/lua_string.hc
@contract id=holyc_string_gc path=src/platform/templeos/lua_string.hc claim="pool sweep removes interned strings whose only remaining reference belongs to the pool" evidence=src/platform/templeos/lua_string.hc
@contract id=holyc_gc_roots path=src/platform/templeos/lua_gc.hc claim="GC facade records state/table roots and sweeps pool-only strings without invalidating retained values" evidence=src/platform/templeos/lua_gc.hc
@contract id=holyc_call path=src/platform/templeos/lua_call.hc claim="native closures execute through a growable frame stack and protected error boundary" evidence=src/platform/templeos/lua_call.hc
@contract id=holyc_call_abi path=src/platform/templeos/lua_call.hc claim="native closure ABI writes result through an output I64 parameter to remain compatible with hcc function pointers" evidence=src/platform/templeos/lua_call.hc
@contract id=holyc_mini_eval path=src/platform/templeos/lua_mini.hc claim="mini evaluator handles nil/boolean/number/string values (LuaMiniValue), return, block-scoped locals and globals, calls to abs/sqrt/len/print/type, string concatenation (..), nested if/elseif/else blocks, break, while/numeric for/repeat-until loops, goto/label jumps within the live block chain, bare call statements (e.g. print(x)), and/or with short-circuit evaluation, comparisons < <= > >= == ~= usable as expressions (not just conditions), parentheses, unary - and #, arithmetic + - * / % with precedence and floored modulo, and `function name(a, b) ... end` declarations called with real recursion through the host C stack (call_depth capped at 200, but the shared 64-slot locals array is the practical recursion limit)" evidence=src/platform/templeos/lua_mini.hc
@contract id=holyc_mini_skip path=src/platform/templeos/lua_mini.hc claim="non-executed blocks are parsed in skip mode: no assignments, native calls, unknown-name or division errors" evidence=src/platform/templeos/lua_mini.hc
@contract id=holyc_mini_registry path=src/platform/templeos/lua_mini.hc claim="registry exposes named native functions using output-parameter hcc ABI" evidence=src/platform/templeos/lua_mini.hc
@task id=port_memory status=active next="connect LuaMemory to the HolyC Lua state implementation"
@task id=port_state status=paused next="add tables to the mini nucleus (the last major gap for a usable-language milestone); general scalar values and recursive functions are done" note="LuaMiniValue (nil/boolean/number/string), concatenation, and/or, print/type, bare call statements, comparisons-as-expressions, and function name(...) ... end with real recursion implemented and validated with hcc -jit tests/holyc_mini.hc (59 assertions)"
@task id=port_strings status=active next="add garbage collection roots for interned strings and tables"
@task id=port_gc status=active next="replace reference-counted string sweep with full object marking"
@task id=port_runtime status=active next="port memory first, then replace non-local error handling in ldo.c"
@risk id=hcc_f64_compare level=medium scope="src/platform/templeos/*.hc" note="hcc v0.0.15 misorders F64 against integer literals (use 0.0) and types F64 comparisons as F64 (no && with Bool, no Bool assignment)" evidence=src/platform/templeos/lua_mini.hc
@risk id=hcc_throw_hex level=low scope="src/platform/templeos/*.hc" note="hcc v0.0.15's uncaught-throw diagnostic prints the thrown code in hex, not decimal (throw(17) prints '11'); not a bug, but easy to misread while debugging" evidence=src/platform/templeos/lua_mini.hc
@risk id=mini_goto_scope level=low scope=mod.templeos_mini note="LuaMiniRun's goto/label resolves against any label reachable while unwinding the live block chain, including one inside an untaken if/elseif/else branch reached only as a jump target; real Lua forbids jumping into a block's scope, this nucleus does not enforce that" evidence=src/platform/templeos/lua_mini.hc
@risk id=hcc_struct_return_crash level=high scope="src/platform/templeos/*.hc" note="hcc v0.0.15's JIT segfaults on `return F();` when F's return type is a large class/struct (e.g. one holding a 64-byte array) — always materialize into a local first: `T v = F(); return v;`. Confirmed independent of any pointer argument; reproduced with the smallest possible case." evidence=src/platform/templeos/lua_mini.hc
@risk id=hcc_f64_return_literal level=high scope="src/platform/templeos/*.hc" note="hcc v0.0.15's JIT silently returns 0 from an F64 function when the return statement is an integer literal (`return 3;`) or an I64-typed local/expression — the value is dropped, not converted. Use an explicit float literal (`return 3.0;`) or a postfix cast (`return x(F64);`). This is broader than the previously-known F64-vs-integer-literal comparison risk." evidence=src/platform/templeos/lua_mini.hc
@risk id=hcc_pointer_and level=medium scope="src/platform/templeos/*.hc" note="hcc v0.0.15 rejects `&&` where either side is a bare pointer or a `!pointer` negation chained with more `&&` terms (\"cannot be applied to a pointer type\"); compare explicitly against NULL instead (`ptr != NULL && ...`, `ptr == NULL && ...`). A lone `!ptr` outside && is fine." evidence=src/platform/templeos/lua_mini.hc
@risk id=mini_recursion_depth level=low scope=mod.templeos_mini note="LuaMiniCallFunction's call_depth guard (200) is unreachable in practice: recursive calls share one flat 64-slot locals array (LuaMiniParser.names/values) that is not popped until the call returns, so deep recursion (e.g. more than ~60 live parameters across frames) hits error 7 well before error 31. Raising the practical limit further means enlarging that array, not call_depth." evidence=src/platform/templeos/lua_mini.hc
